rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{file} {                    // avatars/<uid>.jpg
      allow read: if request.auth != null;
      allow write: if request.auth != null && file == request.auth.uid + '.jpg'
                   && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /chats/{chatId}/{uid}/{file} {       // lampiran chat: hanya pemilik folder yang boleh upload/hapus
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 26 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /statuses/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
