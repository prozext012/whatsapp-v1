rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Chat 1-1 punya ID urut "uidA_uidB" sehingga pesan pertama bisa dibaca sebelum dokumen chat ada
    function chatOk(id) {
      let p = /databases/$(database)/documents/chats/$(id);
      return exists(p) ? request.auth.uid in get(p).data.participants
                       : request.auth.uid in id.split('_');
    }
    match /users/{uid} {                       // profil publik (tanpa email)
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }
    match /users_private/{uid} {               // email: hanya pemilik
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /usernames/{name} {                  // kunci keunikan username
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /chats/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
        && ((request.resource.data.get('type', 'direct') == 'direct' && request.resource.data.participants.size() == 2)
         || (request.resource.data.type == 'group' && request.resource.data.participants.size() >= 2
             && request.resource.data.participants.size() <= 50));
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      match /messages/{mid} {
        allow read: if signedIn() && chatOk(id);
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.participants;
        // pengirim boleh ubah (hapus-untuk-semua); penerima hanya boleh ubah "status" (diterima/dibaca)
        allow update: if signedIn() && (resource.data.senderId == request.auth.uid
          || (request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.participants
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      }
    }
    match /statuses/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }
  }
}
